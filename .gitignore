# ============================================================================
# Tracked exceptions — MUST come last to override patterns above.
# Tenant template configs under workspace-seeds/ are versioned in Git.
# They carry ${LITELLM_KEY}/${LITELLM_URL}/${TENANT_ID} placeholders that
# the provisioner substitutes at tenant-create time — no real secrets.
# ============================================================================
!workspace-seeds/**/config.json
!workspace-seeds/**/.security.yml
