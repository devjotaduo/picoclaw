# Copy to /etc/picoclaw/r2-backup.env (chmod 600, root only) and fill in
# the values. NEVER commit a populated copy of this file.
#
# How to obtain each value:
#
#   1. Sign in to https://dash.cloudflare.com -> R2 Object Storage.
#   2. Create a bucket (e.g. `picoclaw-tenant-backups`). Note the bucket
#      name -> R2_BUCKET below.
#   3. Click "Manage R2 API Tokens" -> "Create API Token":
#        - Permission: Object Read & Write
#        - Bucket: limit to the bucket created above
#        - TTL: leave unset (no expiry) — this token lives on the VPS only
#      The dashboard shows:
#        - Access Key ID  -> R2_ACCESS_KEY_ID
#        - Secret Access Key -> R2_SECRET_ACCESS_KEY  (shown ONCE — copy now)
#        - The S3-compatible endpoint URL -> R2_ENDPOINT
#   4. Choose a strong restic encryption passphrase. STORE IT IN YOUR
#      PASSWORD MANAGER. Losing this passphrase makes every backup
#      cryptographically unreadable — there is no recovery.

R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=picoclaw-tenant-backups
RESTIC_PASSWORD=replace-with-strong-passphrase-stored-in-password-manager

# ── Postgres backup (audit P0 #3, 2026-05-27) ────────────────────────
# The backup script runs `docker exec <container> pg_dumpall -U <user>`
# before each restic snapshot, writing the gzipped dump to
# /var/lib/picoclaw-pg-dumps which restic then snapshots. These vars
# override defaults; remove the # to customize.
#
# PICOCLAW_PG_CONTAINER=postgres        # docker container name
# PICOCLAW_PG_USER=picoclaw              # superuser for pg_dumpall (must
                                          # match POSTGRES_USER in /srv/saas/picoclaw/.env)
# PICOCLAW_PG_DUMP_DIR=/var/lib/picoclaw-pg-dumps  # local staging
#
# If you don't run Postgres on this host, the script auto-skips this
# step with a WARN log line and continues with filesystem backup.
#
# Restore example:
#   1. Pull latest pg_dumpall from R2 via restic:
#        restic restore latest --target /tmp/restore --path /var/lib/picoclaw-pg-dumps
#   2. Drop & recreate the postgres data dir, restart the container.
#   3. cat /tmp/restore/var/lib/picoclaw-pg-dumps/pg_dumpall-*.sql.gz \
#        | gunzip | docker exec -i postgres psql -U picoclaw postgres

