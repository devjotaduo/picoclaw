[Unit]
Description=Picoclaw auto-deploy from origin/main
Documentation=https://github.com/devjotaduo/picoclaw/blob/main/docs/operations/auto-deploy.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/picoclaw-deploy.sh
# Run as root because the script needs to:
#   - systemctl restart picoclaw-main-dev.service
#   - docker (via make saas-dev-controlplane)
#   - write to /root/picoclaw working tree
User=root
Group=root
# Belt-and-braces: even if the script forgets `set -e`, never let a deploy
# burn CPU forever.
TimeoutStartSec=10min
# Low priority so a stuck deploy doesn't starve the launcher itself.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=5
