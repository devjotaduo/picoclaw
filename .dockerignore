.gitignore
.agents/
.cache/
.claude/
.claude-flow/
.codex/
.codex-dev/
.codex-dev-logs/
.playwright-mcp/
.ruflo/
.swarm/
.worktrees/
build/
.picoclaw/
config/
home/
.env
.env.example
*.db
*.db-shm
*.db-wal
*.fbk
*.rvf
*.rvf.lock
*.zip
/*.png
/*.exe
/picoclaw
/picoclaw-saas
/picoclaw-launcher
/picoclaw-tenantctl
**/node_modules/
**/dist/
**/dist-server/
web/frontend/node_modules/
web/saas-admin/node_modules/
docker/saas/opencrm/node_modules/
web/saas-admin/dist/
docker/saas/opencrm/dist/
docker/saas/opencrm/dist-server/
*.md
assets/
workspace/state/
workspace/sessions/
workspace/whatsapp/
workspace/runtime-user-env/
workspace*/heartbeat.log
workspace-assistente/
workspace-marketing/
workspace-pico/
workspace-vendas/
!web/backend/dist/.gitkeep
!internal/saas/api/dist/.gitkeep
