{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    // Upstream is built with wrangler/esbuild (transpile-only); tsc with full
    // strict mode catches several `Record<string, unknown>` vs typed-schema
    // mismatches in upstream/index.ts. We're keeping the upstream untouched,
    // so we degrade to transpile-style: loose types + skip lib check.
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "outDir": "dist-server",
    "rootDir": "src",
    "declaration": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["src/server"]
}
