# jotaduo-wa-sidecar env vars. Append to your existing docker/saas/.env.
#
# The sidecar owns Jotaduo's institutional WhatsApp pairing and lets multiple
# public tenants send/receive on its behalf via a tiny HTTP API. Without it
# the public-tenant flow can only chat with leads through the SSE web channel
# — no outreach via WhatsApp.
#
# See docs/architecture/public-tenant-promotion.md for the broader flow and
# cmd/jotaduo-wa-sidecar/README.md for operational details.

# HMAC secret used by public tenants to sign POST /internal/wa/send and
# POST /internal/wa/routing requests. Also used by the controlplane to sign
# DELETE /internal/wa/routing/by-tenant/{id} at promotion time.
#
# Generate once: openssl rand -hex 32
# Mirror this value into the controlplane env as PICOCLAW_JOTADUO_WA_HMAC_SECRET
# (Fatia 3 PR) so the provisioner can inject it into public tenants.
JOTADUO_WA_HMAC_SECRET=

# Admin token gating the operator pairing UI at
# https://adm.<base>/jotaduo-wa/pair?token=<this>.
# Different secret from HMAC because this one travels in browser URLs.
#
# Generate once: openssl rand -hex 24
JOTADUO_WA_ADMIN_TOKEN=
