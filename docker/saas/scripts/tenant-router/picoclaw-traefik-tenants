#!/usr/bin/env bash
# Scans for tenant containers (label picoclaw.saas.managed=true) and writes a
# Traefik dynamic config so HTTP-01 cert issuance happens per subdomain.
# Each tenant gets its own Host() router; traffic still goes to the
# controlplane (which does the subdomain -> tenant proxy + HMAC handshake).
#
# Tenants live behind the SAAS controlplane reverse proxy — exposing them
# directly via Traefik would skip the trusted-gateway HMAC and break tenant
# isolation. This script is paired with picoclaw-tenant-router-watch, which
# invokes it on docker container lifecycle events.
set -e
DOMAIN="${SAAS_BASE_DOMAIN:-jotaduo.com}"
OUT="${TENANTS_YAML:-/srv/saas/picoclaw/docker/saas/traefik/dynamic/tenants.yml}"
TMP=$(mktemp)

{
  echo "# AUTO-GENERATED by picoclaw-traefik-tenants. Do not edit by hand."
  echo "http:"
  echo "  routers:"
  TENANTS=$(docker ps --filter "label=picoclaw.saas.managed=true" --format '{{.Names}} {{.Label "picoclaw.saas.subdomain"}}')
  if [ -z "$TENANTS" ]; then
    echo "    {}"
  else
    echo "$TENANTS" | while IFS=' ' read -r name sub; do
      [ -z "$sub" ] && continue
      cat <<ROUT
    tenant-${sub}:
      rule: "Host(\`${sub}.${DOMAIN}\`)"
      entryPoints:
        - websecure
      service: controlplane-svc
      middlewares:
        - security-headers
      tls:
        certResolver: letsencrypt
ROUT
    done
  fi
  echo "  services:"
  echo "    controlplane-svc:"
  echo "      loadBalancer:"
  echo "        servers:"
  echo "          - url: \"http://controlplane:8080\""
} > "$TMP"

mv "$TMP" "$OUT"
echo "$(date -Is) wrote $OUT"
