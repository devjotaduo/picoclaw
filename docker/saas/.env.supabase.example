# Supabase + auto-provision env vars for the SaaS controlplane.
# Append these to your existing docker/saas/.env (the same file the base
# compose reads). Vars left blank disable the corresponding feature, so it's
# safe to keep this file partial during incremental rollout.
#
# ── Supabase project (real values for devjotaduo's Project) ────────────────
# These three are safe to commit — they're public per the Supabase docs.
SUPABASE_PROJECT_REF=dgldymxofhmsfeuzgoig
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRnbGR5bXhvZmhtc2ZldXpnb2lnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzkyNzExNzEsImV4cCI6MjA5NDg0NzE3MX0.qeORboLHMZx86StFbabD_Y6Zkhk2qQqI1GaJ1-5tSd0
SUPABASE_SITE_URL=https://jotaduo.com

# ── Secrets — pull these from the Supabase dashboard and KEEP THEM OUT OF GIT ─
# 1. Dashboard → Settings → API → "Project API keys" → service_role (secret)
#    https://supabase.com/dashboard/project/dgldymxofhmsfeuzgoig/settings/api-keys
SUPABASE_SERVICE_ROLE_KEY=

# 2. JWT Secret (HS256) — OPTIONAL.
#    Modern Supabase projects (created Apr 2024+) sign user access tokens
#    with asymmetric keys (ES256/RS256). The controlplane fetches the public
#    JWKS automatically from https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
#    so no secret is needed.
#    Only set this if your project still uses the legacy HS256 shared secret
#    (Dashboard → Settings → API → "JWT Settings" → JWT Secret).
SUPABASE_JWT_SECRET=

# ── Auto-provision (Clara → tenant) ────────────────────────────────────────
# Flip to true once both secrets above are set AND you've validated the
# happy path manually via the admin UI tenant create flow.
PICOCLAW_SAAS_AUTO_PROVISION=false
PICOCLAW_SAAS_AUTO_PROVISION_PROFILE=default-business
PICOCLAW_SAAS_AUTO_PROVISION_PER_IP_DAY=3
PICOCLAW_SAAS_AUTO_PROVISION_LOGIN_MODE=magic_link

# When set, overlays this directory into <tenant_volume>/workspace/ after
# the profile seed runs, so new tenants get the canonical team Rafael /
# Clara / Marcos / Camila + Atendimento Humano with the heartbeat-driven
# proactive engine, 2 marketing cron jobs (Maya weekly + monthly), 26
# curated skills, and 10 memory templates ready for the tenant to fill via
# `config/company-profile.md`.
#
# OverlayWorkspace filters the operator's runtime state on the way in:
# whatsapp/, sessions/, state/, runtime-user-env/, logs/, *.log, *.pid,
# *.sock, *.key, *.db are NEVER copied. memory/* is copy-if-missing — new
# tenants get the template files (empresa.md, leads.md, faq.md, …) and
# existing tenants keep their accumulated knowledge on re-overlay.
#
# The path must exist on the host AND be bind-mounted into the controlplane
# container at the same path — see the controlplane.volumes block in
# docker/saas/docker-compose.yml (and docker-compose.1panel.yml). To install:
#
#   1. scp -r workspace root@vps:/srv/picoclaw/
#   2. docker compose up -d controlplane     (picks up the bind on restart)
#
# Leave blank to disable the overlay entirely and fall back to the
# launcher_profile seed only.
PICOCLAW_SAAS_AUTO_PROVISION_WORKSPACE_DIR=/srv/picoclaw/workspace
