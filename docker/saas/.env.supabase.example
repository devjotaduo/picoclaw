# Supabase + auto-provision env vars for the SaaS controlplane.
# Append these to your existing docker/saas/.env (the same file the base
# compose reads). Vars left blank disable the corresponding feature, so it's
# safe to keep this file partial during incremental rollout.
#
# ── Supabase project (real values for devjotaduo's Project) ────────────────
# These three are safe to commit — they're public per the Supabase docs.
SUPABASE_PROJECT_REF=dgldymxofhmsfeuzgoig
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRnbGR5bXhvZmhtc2ZldXpnb2lnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzkyNzExNzEsImV4cCI6MjA5NDg0NzE3MX0.qeORboLHMZx86StFbabD_Y6Zkhk2qQqI1GaJ1-5tSd0
SUPABASE_SITE_URL=https://jotaduo.com

# ── Secrets — pull these from the Supabase dashboard and KEEP THEM OUT OF GIT ─
# 1. Dashboard → Settings → API → "Project API keys" → service_role (secret)
#    https://supabase.com/dashboard/project/dgldymxofhmsfeuzgoig/settings/api-keys
SUPABASE_SERVICE_ROLE_KEY=

# 2. JWT Secret (HS256) — OPTIONAL.
#    Modern Supabase projects (created Apr 2024+) sign user access tokens
#    with asymmetric keys (ES256/RS256). The controlplane fetches the public
#    JWKS automatically from https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
#    so no secret is needed.
#    Only set this if your project still uses the legacy HS256 shared secret
#    (Dashboard → Settings → API → "JWT Settings" → JWT Secret).
SUPABASE_JWT_SECRET=

# ── Auto-provision (Clara → tenant) ────────────────────────────────────────
# Flip to true once both secrets above are set AND you've created at least
# one Workspace marked `is_default_auto` via adm.<base>/workspaces.
# Without one, Clara's qualifier fails fast with a clear error.
PICOCLAW_SAAS_AUTO_PROVISION=false
PICOCLAW_SAAS_AUTO_PROVISION_PER_IP_DAY=3
# Login mode is no longer a toggle — when Supabase is configured the new
# tenant owner always receives email + senha AND a magic link in the same
# transactional email (credentials.{html,txt}.tmpl).

# Host root for selectable Workspaces. Each subdir is one workspace with
# home/ (tenant $PICOCLAW_HOME bind-mount), frontend-src/ (admin-edited
# React source), and frontend-dist/ (compiled vite output bind-mounted
# into the tenant). See docs/architecture/workspaces.md for the layout
# and required files. Bind-mounted into the controlplane at the same
# path so this env var is portable.
PICOCLAW_WORKSPACE_DIR=/srv/picoclaw-workspaces

# ── Transactional SMTP (Brevo) ─────────────────────────────────────────────
# Used by Mailer.SendCredentialsEmail to deliver "URL + email + senha + magic
# link" in a single email after every tenant provision (manual or auto).
#
# Setup (5 min):
#   1. Sign up at https://app.brevo.com (free tier: 300 emails/day).
#   2. Senders & IP → Domains → add `jotaduo.com` → publish the 3 DNS records
#      (SPF, DKIM, brevo-code TXT) on your DNS provider. Wait for green check.
#   3. SMTP & API → SMTP → "Generate a new SMTP key". Copy the key.
#   4. Set SMTP_USER to the *account login email* (NOT contato@jotaduo.com)
#      and SMTP_PASSWORD to the SMTP key from step 3.
#   5. Restart the controlplane (`make saas-dev-controlplane` or
#      `docker compose up -d controlplane`) and create a tenant via
#      adm.<base>/tenants/new — the owner should receive the email.
#
# Disable SMTP in the Supabase dashboard (Auth → SMTP Settings → leave default
# / unchecked) so the owner doesn't get a duplicate magic-link email from
# Supabase. We already include the magic link in our own template.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAILER_FROM=contato@jotaduo.com
MAILER_ADMIN_URL=https://adm.jotaduo.com
