              "catalog_html",
              "simple_site"
            ],
            "approval_mode": "owner_required",
            "public_publish_dir": "public/marketing",
            "brand_kit": {
              "tone": "natural, prática, sem jargão de marketing",
              "forbidden_terms": [
                "alavancar",
                "engajar",
                "potencializar",
                "viralizar",
                "boost",
                "ROI"
              ],
              "dont": [
                "usar emoji",
                "usar rosto de pessoa real sem autorização",
                "prometer resultado de campanha",
                "criar conteúdo político ou religioso sem pedido explícito"
              ]
            },
            "cadence": {
              "posts_per_week": 3,
              "campaigns_per_month": 1,
              "planning_horizon": "1-4 weeks"
            },
            "trend_sources": [
              "instagram",
              "google_trends",
              "competitors"
            ],
            "default_image_sizes": {
              "instagram_feed": "1080x1350",
              "instagram_square": "1080x1080",
              "stories_reels": "1080x1920"
            },
            "requires_human_review": true
          }
