{
  "session": {
    "dimensions": [
      "chat"
    ]
  },
  "version": 3,
  "isolation": {},
  "ui": {
    "show_reasoning": true,
    "show_tool_calls": true,
    "show_model_selector": true
  },
  "agents": {
    "defaults": {
      "workspace": "/root/.picoclaw/workspace",
      "restrict_to_workspace": true,
      "allow_read_outside_workspace": false,
      "provider": "litellm",
      "model_name": "default",
      "max_tokens": 8192,
      "context_window": 131072,
      "max_tool_iterations": 50,
      "summarize_message_threshold": 20,
      "summarize_token_percent": 75,
      "steering_mode": "one-at-a-time",
      "subturn": {
        "max_depth": 0,
        "max_concurrent": 0,
        "default_timeout_minutes": 0,
        "default_token_budget": 0,
        "concurrency_timeout_sec": 0
      },
      "tool_feedback": {
        "enabled": false,
        "max_args_length": 300,
        "separate_messages": false
      },
      "split_on_marker": false,
      "max_llm_retries": 2,
      "llm_retry_backoff_secs": 2
    },
    "list": [
      {
        "id": "main",
        "default": true,
        "name": "Ana",
        "avatar": {
          "type": "preset",
          "icon": "headset",
          "initials": "AN",
          "background": "#2563eb",
          "foreground": "#ffffff"
        },
        "workspace": "/root/.picoclaw/workspace",
        "subagents": {
          "allow_agents": [
            "vendas"
          ]
        },
        "access": {
          "panel_enabled": true,
          "panel_roles": [
            "tenant_owner",
            "tenant_admin",
            "platform_admin"
          ],
          "whatsapp_direct_enabled": true
        },
        "role_config": {
          "version": 1,
          "kind": "attendant",
          "description": "Atendente principal para informacoes, triagem, duvidas, encaminhamento e agendamento.",
          "attendant": {
            "departments": [
              "vendas",
              "suporte",
              "financeiro",
              "agendamento",
              "humano"
            ],
            "triage_fields": [
              "nome",
              "contato",
              "assunto",
              "urgencia",
              "melhor_canal"
            ],
            "escalation_rules": [
              "reclamacao grave",
              "risco juridico",
              "cancelamento sensivel",
              "desconto ou excecao",
              "informacao nao confirmada"
            ],
            "scheduling_enabled": true,
            "faq_source": "company_context"
          }
        }
      },
      {
        "id": "vendas",
        "name": "Leo",
        "avatar": {
          "type": "preset",
          "icon": "target",
          "initials": "LE",
          "background": "#16a34a",
          "foreground": "#ffffff"
        },
        "workspace": "/root/.picoclaw/workspace-vendas",
        "access": {
          "panel_enabled": true,
          "panel_roles": [
            "tenant_owner",
            "tenant_admin",
            "platform_admin"
          ]
        },
        "role_config": {
          "version": 1,
          "kind": "sales",
          "description": "Consultor comercial para qualificar leads, vender, registrar oportunidades e fazer follow-up.",
          "sales": {
            "funnel_stages": [
              "novo",
              "qualificacao",
              "proposta",
              "follow_up",
              "ganho",
              "perdido"
            ],
            "qualification_fields": [
              "problema",
              "fit",
              "autoridade",
              "prazo",
              "orcamento",
              "proximo_passo"
            ],
            "followup_cadence": [
              "D+1",
              "D+3",
              "D+7"
            ],
            "crm_integration": "future",
            "price_policy_source": "memory/pricing.md",
            "handoff_rules": [
              "lead qualificado com prazo",
              "pedido de contrato",
              "excecao comercial",
              "duvida tecnica fora do escopo"
            ]
          }
        }
      },
      {
        "id": "marketing",
        "name": "Maya",
        "avatar": {
          "type": "preset",
          "icon": "sparkles",
          "initials": "MA",
          "background": "#f43f5e",
          "foreground": "#ffffff"
        },
        "workspace": "/root/.picoclaw/workspace-marketing",
        "access": {
          "panel_enabled": true,
          "panel_roles": [
            "tenant_owner",
            "tenant_admin",
            "platform_admin"
          ]
        },
        "role_config": {
          "version": 1,
          "kind": "marketing",
          "description": "Especialista de marketing para posts, campanhas, catalogos, sites simples, tendencias e materiais visuais.",
          "marketing": {
            "platforms": [
              "instagram",
              "site",
              "catalog_html"
            ],
            "deliverables": [
              "post",
              "reel_cover",
              "carousel",
              "stories",
              "campaign",
              "calendar",
              "catalog_html",
              "simple_site"
            ],
            "approval_mode": "owner_required",
            "public_publish_dir": "public/marketing",
            "brand_kit": {},
            "cadence": {
              "posts_per_week": 3,
              "campaigns_per_month": 1,
              "planning_horizon": "1-4 weeks"
            },
            "trend_sources": [
              "instagram",
              "google_trends",
              "competitors"
            ],
            "default_image_sizes": {
              "instagram_feed": "1080x1350",
              "instagram_square": "1080x1080",
              "stories_reels": "1080x1920"
            },
            "requires_human_review": true
          }
        }
      },
      {
        "id": "assistente",
        "name": "Sofia",
        "avatar": {
          "type": "preset",
          "icon": "assistant",
          "initials": "SO",
          "background": "#7c3aed",
          "foreground": "#ffffff"
        },
        "workspace": "/root/.picoclaw/workspace-assistente",
        "subagents": {
          "allow_agents": [
            "main",
            "vendas",
            "marketing"
          ]
        },
        "access": {
          "panel_enabled": true,
          "panel_roles": [
            "tenant_owner",
            "tenant_admin",
            "platform_admin"
          ],
          "whatsapp_direct_enabled": true
        },
        "role_config": {
          "version": 1,
          "kind": "assistant",
          "description": "Assistente do dono para agenda, relatorios, documentos, workspace e coordenacao dos agentes.",
          "assistant": {
            "authorized_scopes": [
              "workspace",
              "agents",
              "reports",
              "documents",
              "agenda",
              "orchestration"
            ],
            "report_cadence": [
              "daily",
              "weekly",
              "monthly"
            ],
            "can_edit_agents": true,
            "can_call_agents": [
              "main",
              "vendas",
              "marketing"
            ],
            "requires_confirmation": [
              "editar agentes",
              "alterar permissoes",
              "publicar materiais",
              "apagar arquivos",
              "enviar relatorios externos"
            ],
            "audit_level": "high"
          }
        }
      }
    ],
    "dispatch": {
      "rules": [
        {
          "name": "orchestrator:whatsapp:main",
          "agent": "main",
          "when": {
            "channel": "whatsapp"
          },
          "session_dimensions": [
            "chat"
          ]
        },
        {
          "name": "orchestrator:panel:main",
          "agent": "main",
          "when": {
            "channel": "panel",
            "space": "agent:main"
          },
          "session_dimensions": [
            "space",
            "chat"
          ]
        },
        {
          "name": "orchestrator:pico:main",
          "agent": "main",
          "when": {
            "channel": "pico",
            "space": "agent:main"
          },
          "session_dimensions": [
            "space",
            "chat"
          ]
        },
        {
          "name": "orchestrator:panel:vendas",
          "agent": "vendas",
          "when": {
            "channel": "panel",
            "space": "agent:vendas"
          },
          "session_dimensions": [
            "space",
            "chat"
          ]
        },
        {
          "name": "orchestrator:pico:vendas",
          "agent": "vendas",
          "when": {
            "channel": "pico",
            "space": "agent:vendas"
          },
          "session_dimensions": [
            "space",
            "chat"
          ]
        },
        {
          "name": "orchestrator:panel:marketing",
          "agent": "marketing",
          "when": {
            "channel": "panel",
            "space": "agent:marketing"
          },
          "session_dimensions": [
            "space",
            "chat"
          ]
        },
        {
          "name": "orchestrator:pico:marketing",
          "agent": "marketing",
          "when": {
            "channel": "pico",
            "space": "agent:marketing"
          },
          "session_dimensions": [
            "space",
            "chat"
          ]
        },
        {
          "name": "orchestrator:panel:assistente",
          "agent": "assistente",
          "when": {
            "channel": "panel",
            "space": "agent:assistente"
          },
          "session_dimensions": [
            "space",
            "chat"
          ]
        },
        {
          "name": "orchestrator:panel:gerente",
          "agent": "assistente",
          "when": {
            "channel": "panel",
            "space": "agent:gerente"
          },
          "session_dimensions": [
            "space",
            "chat"
          ]
        },
        {
          "name": "orchestrator:pico:assistente",
          "agent": "assistente",
          "when": {
            "channel": "pico",
            "space": "agent:assistente"
          },
          "session_dimensions": [
            "space",
            "chat"
          ]
        },
        {
          "name": "orchestrator:pico:gerente",
          "agent": "assistente",
          "when": {
            "channel": "pico",
            "space": "agent:gerente"
          },
          "session_dimensions": [
            "space",
            "chat"
          ]
        }
      ]
    }
  },
