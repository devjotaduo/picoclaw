{
  "_comment": "Baseline behavior — matches pkg/agent/DefaultBehavior. The Picoclaw runtime applies these toggles BEFORE invoking the LLM (master switch, DM/group, business-hours gate, media filters, PII masking, handoff keywords). Field names/types mirror pkg/agent/behavior.go::Behavior so the apply-template handler round-trips cleanly. Edit via the workspace files editor or replace via the agent template editor in the admin.",

  "master_enabled": true,
  "business_hours_only": false,
  "out_of_hours_reply": "",

  "respond_in_dm": true,
  "respond_in_groups": true,
  "group_mention_only": false,
  "keyword_trigger": "",

  "outbound_only_mode": false,
  "ignore_other_bots": false,
  "ignore_forwarded_messages": false,
  "ignore_self_messages": true,

  "process_images": true,
  "process_documents": true,
  "process_audio": true,
  "process_video": true,
  "process_stickers": true,
  "process_location": true,
  "max_media_size_mb": 25,

  "session_timeout_minutes": 0,
  "max_messages_per_session": 0,
  "mask_pii_in_replies": false,
  "store_received_media": false,
  "max_messages_per_minute_per_user": 0,
  "response_cooldown_seconds": 0,
  "handoff_keywords": [],
  "handoff_after_failures": 0,
  "operator_identification_mode": "",

  "schedule": {
    "monday":    { "open": true,  "from": "09:00", "to": "18:00" },
    "tuesday":   { "open": true,  "from": "09:00", "to": "18:00" },
    "wednesday": { "open": true,  "from": "09:00", "to": "18:00" },
    "thursday":  { "open": true,  "from": "09:00", "to": "18:00" },
    "friday":    { "open": true,  "from": "09:00", "to": "18:00" },
    "saturday":  { "open": false, "from": "",      "to": "" },
    "sunday":    { "open": false, "from": "",      "to": "" },
    "notes": "Edite os dias da semana ou ative business_hours_only=true pra restringir respostas ao horário comercial."
  }
}
