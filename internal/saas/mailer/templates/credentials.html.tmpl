<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" lang="pt-BR">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light dark" />
  <meta name="supported-color-schemes" content="light dark" />
  <title>Acesso Jota Duo</title>
  <style>
    /* Progressive dark mode — respected by Apple Mail, Gmail iOS, Outlook iOS.
       Other clients ignore the @media block and keep the light defaults. */
    @media (prefers-color-scheme: dark) {
      .body-bg { background-color: #0b1220 !important; }
      .card-bg { background-color: #111a2c !important; border-color: #1f2a44 !important; }
      .header-bg { background-color: #0e2419 !important; border-color: #1f2a44 !important; }
      .footer-bg { background-color: #0d1626 !important; border-color: #1f2a44 !important; }
      .field-bg  { background-color: #0e1424 !important; border-color: #1f2a44 !important; }
      .text-primary { color: #e6edf7 !important; }
      .text-secondary { color: #bac3d2 !important; }
      .text-muted { color: #7d8ba5 !important; }
      .text-brand { color: #34d399 !important; }
      .brand-btn { background-color: #16a34a !important; }
      .brand-btn a { background-color: #16a34a !important; }
      .warning-bg { background-color: #2a1d0a !important; }
      .warning-text { color: #fcd34d !important; }
      .copy-hint-bg { background-color: #0e1424 !important; }
    }
    /* Outlook desktop / Office365 ignore CSS media — fine, they render light. */
    a { color: #15803d; }
  </style>
</head>
<body class="body-bg" style="margin:0;padding:0;background-color:#f5f5f5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#2c2c2c;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="body-bg" style="background-color:#f5f5f5;">
    <tr><td align="center" style="padding:40px 16px;">

      <!-- Card -->
      <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" class="card-bg" style="max-width:600px;background-color:#ffffff;border:1px solid #e5e5e5;border-radius:12px;overflow:hidden;">

        <!-- Header com fundo verde-claro -->
        <tr><td class="header-bg" style="padding:24px 32px;background-color:#f0fdf4;border-bottom:1px solid #e5e5e5;">
          <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
            <td style="vertical-align:middle;">
              <span style="display:inline-block;width:40px;height:40px;background:linear-gradient(135deg,#15803d 0%,#0e5a2b 100%);background-color:#15803d;border-radius:10px;color:#ffffff;font-size:22px;font-weight:700;line-height:40px;text-align:center;font-family:Arial,sans-serif;">J</span>
            </td>
            <td style="vertical-align:middle;padding-left:14px;">
              <div class="text-primary" style="font-size:18px;font-weight:700;color:#0e5a2b;line-height:1.2;">Jota Duo</div>
              <div class="text-muted" style="font-size:12px;color:#15803d;line-height:1.4;margin-top:2px;">Atendimento conversacional com IA</div>
            </td>
          </tr></table>
        </td></tr>

        <!-- Conteúdo -->
        <tr><td style="padding:36px 32px 24px 32px;">
          <h1 class="text-primary" style="margin:0 0 18px 0;font-size:24px;font-weight:700;color:#1a1a1a;line-height:1.25;letter-spacing:-0.01em;">
            Acesso ao painel <span class="text-brand" style="color:#15803d;">{{.TenantName}}</span>
          </h1>
          <p class="text-secondary" style="margin:0 0 28px 0;font-size:15px;line-height:1.7;color:#4a4a4a;">
            Olá! Seu painel <strong>{{.TenantName}}</strong> está pronto. Você pode
            entrar de duas formas — use a que preferir.
          </p>

          <!-- Opção 1: Email + senha -->
          <h2 class="text-brand" style="margin:0 0 14px 0;font-size:14px;font-weight:700;text-transform:uppercase;letter-spacing:0.6px;color:#15803d;">
            Opção 1 &nbsp;·&nbsp; Email + senha
          </h2>
          <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" class="field-bg" style="margin:0 0 28px 0;border:1px solid #e5e5e5;border-radius:8px;background-color:#fafafa;">
            <tr><td style="padding:14px 20px;border-bottom:1px solid #efefef;">
              <p class="text-muted" style="margin:0 0 6px 0;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.6px;color:#8a8a8a;">URL</p>
              <p style="margin:0;font-size:14px;line-height:1.5;word-break:break-all;">
                <a href="{{.DashboardURL}}" class="text-brand" style="color:#15803d;text-decoration:none;font-weight:500;">{{.DashboardURL}}</a>
              </p>
            </td></tr>
            <tr><td style="padding:14px 20px;border-bottom:1px solid #efefef;">
              <p class="text-muted" style="margin:0 0 6px 0;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.6px;color:#8a8a8a;">Email</p>
              <p class="text-primary" style="margin:0;font-size:14px;line-height:1.5;color:#2c2c2c;font-family:Menlo,Consolas,'Liberation Mono',monospace;">{{.LoginEmail}}</p>
            </td></tr>
            <tr><td style="padding:14px 20px;">
              <p class="text-muted" style="margin:0 0 6px 0;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.6px;color:#8a8a8a;">Senha</p>
              <p class="text-primary" style="margin:0;font-size:14px;line-height:1.5;color:#2c2c2c;font-family:Menlo,Consolas,'Liberation Mono',monospace;">{{.LoginPassword}}</p>
            </td></tr>
          </table>

          {{if .MagicLink}}
          <!-- Opção 2: Magic link -->
          <h2 class="text-brand" style="margin:0 0 14px 0;font-size:14px;font-weight:700;text-transform:uppercase;letter-spacing:0.6px;color:#15803d;">
            Opção 2 &nbsp;·&nbsp; Link de acesso
          </h2>
          <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 auto 14px auto;">
            <tr><td align="center" bgcolor="#15803d" class="brand-btn" style="border-radius:8px;border-bottom:2px solid #0e5a2b;">
              <a href="{{.MagicLink}}" style="display:inline-block;padding:16px 36px;font-size:15px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:8px;background-color:#15803d;letter-spacing:0.01em;">Entrar com link de acesso &nbsp;→</a>
            </td></tr>
          </table>
          <div class="copy-hint-bg" style="margin:0 0 28px 0;padding:14px 18px;background-color:#f7faf7;border-left:3px solid #15803d;border-radius:6px;">
            <p class="text-muted" style="margin:0;font-size:12px;line-height:1.5;color:#6a6a6a;">Não consegue clicar? Copie no navegador:</p>
            <p class="text-brand" style="margin:8px 0 0 0;font-size:11px;line-height:1.55;color:#15803d;word-break:break-all;font-family:Menlo,Consolas,'Liberation Mono',monospace;">{{.MagicLink}}</p>
          </div>
          {{else}}
          <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:8px auto 28px auto;">
            <tr><td align="center" bgcolor="#15803d" class="brand-btn" style="border-radius:8px;border-bottom:2px solid #0e5a2b;">
              <a href="{{.DashboardURL}}" style="display:inline-block;padding:16px 36px;font-size:15px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:8px;background-color:#15803d;letter-spacing:0.01em;">Abrir painel &nbsp;→</a>
            </td></tr>
          </table>
          {{end}}

          <!-- Aviso senha -->
          <div class="warning-bg" style="margin:28px 0 0 0;padding:14px 18px;background-color:#fff7e6;border-left:3px solid #d97706;border-radius:6px;">
            <p class="warning-text" style="margin:0;font-size:12.5px;line-height:1.55;color:#92400e;">
              <span style="font-weight:700;">⚠ Guarde este email</span> — a senha não será mostrada novamente.
              Você pode alterá-la no painel depois do primeiro login.
            </p>
          </div>

          <p class="text-muted" style="margin:28px 0 0 0;font-size:13px;line-height:1.6;color:#6a6a6a;">
            Não esperava esse acesso? Avise-nos em
            <a href="mailto:{{.SupportEmail}}" class="text-brand" style="color:#15803d;text-decoration:none;font-weight:500;">{{.SupportEmail}}</a>.
          </p>
        </td></tr>

        <!-- Footer -->
        <tr><td class="footer-bg" style="padding:22px 32px;background-color:#fafafa;border-top:1px solid #e5e5e5;">
          <p class="text-primary" style="margin:0 0 6px 0;font-size:13px;font-weight:600;line-height:1.5;color:#2c2c2c;">
            Jota Duo
          </p>
          <p class="text-muted" style="margin:0 0 10px 0;font-size:12px;line-height:1.5;color:#6a6a6a;">
            Atendimento conversacional com IA · <a href="mailto:{{.SupportEmail}}" class="text-brand" style="color:#15803d;text-decoration:none;">{{.SupportEmail}}</a>
          </p>
          <p class="text-muted" style="margin:0;font-size:11px;line-height:1.5;color:#a0a0a0;">
            Email transacional enviado para {{.ToEmail}} · © 2026 Jota Duo
          </p>
        </td></tr>

      </table>
    </td></tr>
  </table>
</body>
</html>
