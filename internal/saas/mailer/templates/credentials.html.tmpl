<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" lang="pt-BR">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Credenciais Jotaduo</title>
</head>
<body style="margin:0;padding:0;background-color:#f5f5f5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#2c2c2c;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f5f5f5;">
    <tr><td align="center" style="padding:32px 16px;">
      <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;background-color:#ffffff;border:1px solid #e5e5e5;border-radius:8px;">
        <tr><td style="padding:32px 32px 16px 32px;border-bottom:1px solid #e5e5e5;">
          <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
            <td style="vertical-align:middle;"><span style="display:inline-block;width:36px;height:36px;background-color:#15803d;border-radius:8px;color:#ffffff;font-size:20px;font-weight:700;line-height:36px;text-align:center;font-family:Arial,sans-serif;">J</span></td>
            <td style="vertical-align:middle;padding-left:12px;font-size:18px;font-weight:600;color:#2c2c2c;">Jotaduo</td>
          </tr></table>
        </td></tr>
        <tr><td style="padding:32px;">
          <h1 style="margin:0 0 16px 0;font-size:22px;font-weight:600;color:#2c2c2c;line-height:1.3;">
            Acesso ao painel <span style="color:#15803d;">{{.TenantName}}</span>
          </h1>
          <p style="margin:0 0 24px 0;font-size:15px;line-height:1.6;color:#4a4a4a;">
            Olá! Seu painel <strong>{{.TenantName}}</strong> está pronto. Você pode
            entrar de duas formas — use a que preferir.
          </p>

          <h2 style="margin:0 0 12px 0;font-size:13px;text-transform:uppercase;letter-spacing:0.5px;color:#15803d;">
            Opção 1 · Email + senha
          </h2>
          <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:0 0 24px 0;border:1px solid #e5e5e5;border-radius:6px;background-color:#fafafa;">
            <tr><td style="padding:16px 20px;">
              <p style="margin:0 0 6px 0;font-size:11px;text-transform:uppercase;letter-spacing:0.5px;color:#8a8a8a;">URL</p>
              <p style="margin:0;font-size:14px;line-height:1.5;color:#15803d;word-break:break-all;">
                <a href="{{.DashboardURL}}" style="color:#15803d;text-decoration:none;">{{.DashboardURL}}</a>
              </p>
            </td></tr>
            <tr><td style="padding:0 20px 16px 20px;">
              <p style="margin:0 0 6px 0;font-size:11px;text-transform:uppercase;letter-spacing:0.5px;color:#8a8a8a;">Email</p>
              <p style="margin:0;font-size:14px;line-height:1.5;color:#2c2c2c;font-family:Menlo,Consolas,monospace;">{{.LoginEmail}}</p>
            </td></tr>
            <tr><td style="padding:0 20px 16px 20px;">
              <p style="margin:0 0 6px 0;font-size:11px;text-transform:uppercase;letter-spacing:0.5px;color:#8a8a8a;">Senha</p>
              <p style="margin:0;font-size:14px;line-height:1.5;color:#2c2c2c;font-family:Menlo,Consolas,monospace;">{{.LoginPassword}}</p>
            </td></tr>
          </table>

          {{if .MagicLink}}
          <h2 style="margin:0 0 12px 0;font-size:13px;text-transform:uppercase;letter-spacing:0.5px;color:#15803d;">
            Opção 2 · Magic link (1 clique, link único)
          </h2>
          <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 auto 12px auto;">
            <tr><td align="center" bgcolor="#15803d" style="border-radius:6px;">
              <a href="{{.MagicLink}}" style="display:inline-block;padding:14px 32px;font-size:15px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:6px;background-color:#15803d;">Entrar com magic link</a>
            </td></tr>
          </table>
          <div style="margin:0 0 24px 0;padding:12px 16px;background-color:#f9f9f9;border-left:3px solid #15803d;border-radius:4px;">
            <p style="margin:0;font-size:12px;line-height:1.5;color:#6a6a6a;">Não consegue clicar? Copie no navegador:</p>
            <p style="margin:6px 0 0 0;font-size:11px;line-height:1.5;color:#15803d;word-break:break-all;font-family:Menlo,Consolas,monospace;">{{.MagicLink}}</p>
          </div>
          {{else}}
          <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 auto 24px auto;">
            <tr><td align="center" bgcolor="#15803d" style="border-radius:6px;">
              <a href="{{.DashboardURL}}" style="display:inline-block;padding:14px 32px;font-size:15px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:6px;background-color:#15803d;">Abrir painel</a>
            </td></tr>
          </table>
          {{end}}

          <div style="margin:24px 0;padding:16px;background-color:#fff7e6;border-left:3px solid #d97706;border-radius:4px;">
            <p style="margin:0;font-size:12px;line-height:1.5;color:#92400e;">
              Guarde este email — a senha não será mostrada novamente. Você pode
              alterá-la no painel depois do primeiro login.
            </p>
          </div>
          <p style="margin:24px 0 0 0;font-size:13px;line-height:1.6;color:#6a6a6a;">
            Não esperava esse acesso? Avise-nos em
            <a href="mailto:{{.SupportEmail}}" style="color:#15803d;text-decoration:none;">{{.SupportEmail}}</a>.
          </p>
        </td></tr>
        <tr><td style="padding:24px 32px;background-color:#fafafa;border-top:1px solid #e5e5e5;border-radius:0 0 8px 8px;">
          <p style="margin:0 0 8px 0;font-size:12px;line-height:1.5;color:#8a8a8a;">Jotaduo · <a href="mailto:{{.SupportEmail}}" style="color:#15803d;text-decoration:none;">{{.SupportEmail}}</a></p>
          <p style="margin:0;font-size:11px;line-height:1.5;color:#a0a0a0;">Email transacional enviado para {{.ToEmail}}.</p>
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
