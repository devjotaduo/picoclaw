{
  "version": 1,
  "jobs": [
    {
      "id": "heartbeat-rafael-daily",
      "name": "HEARTBEAT Rafael — Manhã",
      "enabled": false,
      "schedule": { "kind": "cron", "expr": "0 8 * * *", "tz": "America/Sao_Paulo" },
      "payload": { "kind": "message", "message": "HEARTBEAT", "channel": "whatsapp", "to": "[ATUALIZAR — número interno do dono]" }
    },
    {
      "id": "lia-marketing-daily",
      "name": "Lia — Rotina matinal de marketing",
      "enabled": false,
      "schedule": { "kind": "cron", "expr": "0 8 * * *", "tz": "America/Sao_Paulo" },
      "payload": { "kind": "message", "message": "MARKETING_CHECK", "channel": "whatsapp", "to": "[ATUALIZAR — canal interno]" }
    },
    {
      "id": "analytics-daily-report",
      "name": "Analytics — Relatório diário",
      "enabled": true,
      "schedule": { "kind": "cron", "expr": "59 23 * * *", "tz": "America/Sao_Paulo" },
      "payload": { "kind": "command", "command": "analytics.report.daily" }
    },
    {
      "id": "analytics-pattern-weekly",
      "name": "Analytics — Análise de padrões semanal",
      "enabled": true,
      "schedule": { "kind": "cron", "expr": "0 6 * * 1", "tz": "America/Sao_Paulo" },
      "payload": { "kind": "command", "command": "analytics.patterns.weekly" }
    },
    {
      "id": "lia-weekly-proposals",
      "name": "Lia — Tendências e propostas semanais",
      "enabled": false,
      "schedule": { "kind": "cron", "expr": "0 9 * * 1", "tz": "America/Sao_Paulo" },
      "payload": { "kind": "agent_turn", "message": "Gere tendências da semana, ideias de posts e uma campanha semanal. Salve o resultado como proposta de marketing.", "channel": "cron", "to": "lia-weekly-proposals", "agent_id": "lia" }
    },
    {
      "id": "lia-monthly-positioning",
      "name": "Lia — Posicionamento mensal da marca",
      "enabled": false,
      "schedule": { "kind": "cron", "expr": "0 9 1 * *", "tz": "America/Sao_Paulo" },
      "payload": { "kind": "agent_turn", "message": "Gere um relatório mensal de posicionamento da marca com sugestões de melhoria. Salve o resultado como proposta de marketing.", "channel": "cron", "to": "lia-monthly-positioning", "agent_id": "lia" }
    }
  ]
}